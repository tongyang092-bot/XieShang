# 阿里云百炼 API KEY
ALIYUN_API_KEY=
DASHSCOPE_API_KEY=

# DashScope 地域端点：北京使用下列默认值；新加坡使用 https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1

# 高保真试穿编辑模型
TRYON_MODEL=wan2.7-image-pro

# 数据库配置
DATABASE_URL=sqlite:///./data/xieshang.db

# 后端服务配置
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
